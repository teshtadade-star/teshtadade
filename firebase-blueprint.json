{
  "entities": {
    "Dish": {
      "title": "Dish",
      "description": "A food or drink menu item for Têşta Dadê",
      "type": "object",
      "properties": {
        "id": {
          "type": "number",
          "description": "Unique identifier of the dish"
        },
        "name": {
          "type": "string",
          "maxLength": 100,
          "description": "Dish title in Kurdish or Arabic"
        },
        "price": {
          "type": "string",
          "maxLength": 50,
          "description": "Formatted price of the dish (e.g. ٦,٠٠٠ د.ع)"
        },
        "desc": {
          "type": "string",
          "maxLength": 500,
          "description": "Full ingredients and description of the dish"
        },
        "cat": {
          "type": "string",
          "maxLength": 30,
          "description": "Category key: germ, sar, shirin, vexwarin, wejbe, ewaza"
        },
        "img": {
          "type": "string",
          "maxLength": 600000,
          "description": "Image URL or compressed data URI for the dish"
        },
        "isPopular": {
          "type": "boolean",
          "description": "Whether the dish is featured as popular"
        },
        "available": {
          "type": "boolean",
          "description": "Whether the dish is currently in stock and available"
        },
        "isPinned": {
          "type": "boolean",
          "description": "Whether the dish is pinned to the top of the menu"
        },
        "order": {
          "type": "number",
          "description": "Display order priority position"
        }
      },
      "required": ["id", "name", "price", "cat", "desc"]
    },
    "AppSettings": {
      "title": "AppSettings",
      "description": "Global restaurant settings and configurations",
      "type": "object",
      "properties": {
        "brandName": {
          "type": "string",
          "maxLength": 100,
          "description": "Restaurant brand name"
        },
        "subtitle": {
          "type": "string",
          "maxLength": 200,
          "description": "Short slogan or subtitle"
        },
        "restaurantPhone": {
          "type": "string",
          "maxLength": 50,
          "description": "Phone number for incoming customer calls"
        },
        "whatsappPhone": {
          "type": "string",
          "maxLength": 50,
          "description": "WhatsApp number for inquiries"
        },
        "isOpen": {
          "type": "boolean",
          "description": "Whether restaurant is currently open or closed"
        },
        "announcement": {
          "type": "string",
          "maxLength": 300,
          "description": "Special announcement text displayed to customers"
        },
        "showAnnouncement": {
          "type": "boolean",
          "description": "Whether to display the announcement banner"
        },
        "adminPasswordHash": {
          "type": "string",
          "maxLength": 128,
          "description": "Cryptographic SHA-256 password hash"
        },
        "adminPasswordSalt": {
          "type": "string",
          "maxLength": 64,
          "description": "Cryptographic password salt"
        }
      }
    }
  },
  "firestore": {
    "/dishes/{dishId}": {
      "schema": "Dish",
      "description": "Collection of all breakfast and restaurant menu items"
    },
    "/settings/{settingId}": {
      "schema": "AppSettings",
      "description": "App settings document (e.g. settings/app)"
    }
  }
}
